{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "Easter's Delight",
  "description": "A cute add-on for Farmer's Delight adding egg painting and easter-themed foods!",
  "authors": [
    "PhantomWing"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/easters-delight",
    "sources": "https://github.com/PhantomWing/EastersDelight"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.phantomwing.eastersdelight.EastersDelight"
    ],
    "fabric-datagen": [
      "com.phantomwing.eastersdelight.EastersDelightDataGenerator"
    ],
    "client": [
      "com.phantomwing.eastersdelight.EastersDelightClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_min_version} <=${minecraft_max_version}",
    "java": ">=25",
